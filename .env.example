# Shared secret required in the X-Passcode header for /api/progress.
# Pick a long random string, e.g.: openssl rand -hex 24
PASSCODE=change-me-to-a-long-random-string

# Postgres connection string (Neon/Supabase free tier both work).
# Get this from your provider's dashboard, e.g.:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Anthropic API key — powers the "Generate more" AI content feature.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. claude-haiku-4-5 is much cheaper and
# plenty good for this (short, well-defined word/sentence generation) —
# swap it in if you want to cut the per-call cost.
ANTHROPIC_MODEL=

# Optional, defaults to 3000
PORT=3000
